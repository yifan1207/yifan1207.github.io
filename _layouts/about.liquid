---
layout: default
---
<div class="post home-page">
  <section id="about" class="section about-home">
    <div class="hero">
      {% if page.profile and page.profile.image %}
        <div class="portrait">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <img
            src="{{ profile_image_path | relative_url | bust_file_cache }}"
            alt="{{ site.first_name }} {{ site.last_name }}"
            width="420"
            height="420"
          >
        </div>
      {% endif %}

      <div class="prose">
        <header class="post-header">
          <h1 class="post-title">
            {% if site.title == 'blank' %}
              {{ site.first_name }} {{ site.middle_name }}
              {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
            {% if site.chinese_name %}<span class="chinese-name">· {{ site.chinese_name }}</span>{% endif %}
          </h1>
          <p class="role">{{ page.subtitle }}</p>
        </header>

        <div class="about-copy">{{ content }}</div>

        {% if page.social %}
          <div class="pill-row" aria-label="Contact links">
            <a class="pill" href="mailto:{{ site.data.socials.email }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i> Email</a>
            <a class="pill" href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener"><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</a>
            <a class="pill" href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener"><i class="ai ai-google-scholar" aria-hidden="true"></i> Scholar</a>
            <a class="pill" href="https://linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn</a>
            <a class="pill" href="https://x.com/{{ site.data.socials.x_username }}" target="_blank" rel="noopener"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i> X</a>
          </div>
        {% endif %}
      </div>
    </div>
  </section>

  {% if page.selected_papers %}
    <section id="publications" class="section">
      <div class="pub-header">
        <h2 class="section-label">Selected Publications</h2>
      </div>
      <p class="pub-note"><sup>*</sup> equal contribution</p>
      <p class="pub-note pub-note-spaced">
        A complete list of publications can be found on my
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener">Google Scholar</a>
        page.
      </p>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% include experience_education.liquid %}
</div>
